
# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=dev-secret-change-in-prod

# ── Database (local MySQL for development) ────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:YOUR_LOCAL_PASSWORD@localhost:3306/ecocharge
# DB_SSL_REQUIRED=false   # set to true if your DB requires SSL (e.g. Aiven)
# DB_SSL_CA_PATH=         # optional: path to CA cert file downloaded from Aiven

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-jwt-secret-change-in-prod
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ── ESP32 device shared secret ────────────────────────────────────────────────
DEVICE_API_KEY=esp32-device-secret

# ── AI Server (local for dev) ─────────────────────────────────────────────────
AI_SERVER_URL=http://localhost:8001
AI_API_KEY=dev-ai-secret

# ── Supabase Storage ──────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_YOUR_SECRET_KEY_HERE
SUPABASE_BUCKET=ecocharge_bucket

# ── Credits config ────────────────────────────────────────────────────────────
CREDITS_PER_BOTTLE=1
MINUTES_PER_CREDIT=10
