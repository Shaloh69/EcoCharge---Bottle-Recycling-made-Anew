FLASK_ENV=development
SECRET_KEY=change-me-in-production

# MySQL connection string
# Format: mysql+pymysql://user:password@host:port/dbname
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ecocharge

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ESP32 device shared secret (used as Bearer token for device routes)
DEVICE_API_KEY=esp32-device-secret

# RunPod AI server
AI_SERVER_URL=https://your-runpod-endpoint.runpod.net
AI_API_KEY=your-runpod-api-key

# Credits config
CREDITS_PER_BOTTLE=1
MINUTES_PER_CREDIT=10
