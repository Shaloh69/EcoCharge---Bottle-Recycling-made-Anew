# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# Local MySQL (development):
DATABASE_URL=mysql+pymysql://root:YOUR_LOCAL_PASSWORD@localhost:3306/ecocharge
# Aiven MySQL (production) — replace mysql:// with mysql+pymysql://
# DATABASE_URL=mysql+pymysql://avnadmin:PASSWORD@HOST:22294/defaultdb
DB_SSL_REQUIRED=false
# DB_SSL_CA_PATH=certs/ca.pem   # download from Aiven console → CA Certificate

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ── ESP32 device shared secret ────────────────────────────────────────────────
DEVICE_API_KEY=esp32-device-secret

# ── AI Server ─────────────────────────────────────────────────────────────────
# Local:   AI_SERVER_URL=http://localhost:8001
# Tunnel:  AI_SERVER_URL=https://YOUR_TUNNEL.trycloudflare.com
AI_SERVER_URL=http://localhost:8001
AI_API_KEY=dev-ai-secret

# ── Supabase Storage ──────────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_YOUR_SECRET_KEY_HERE
SUPABASE_BUCKET=ecocharge_bucket

# ── Credits config ────────────────────────────────────────────────────────────
CREDITS_PER_BOTTLE=1
MINUTES_PER_CREDIT=10

# ── Seed credentials (used by seed.py only — never sent to clients) ───────────
ADMIN_NAME=EcoCharge Admin
ADMIN_EMAIL=admin@ecocharge.ph
ADMIN_PASSWORD=YourStrongPassword123!
KIOSK_NAME=Kiosk-001
KIOSK_LOCATION=Main Building Lobby
