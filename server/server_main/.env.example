# ── Node ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (self-hosted MySQL 8 in Docker) ──────────────────────────────────
# Dev: point at a local MySQL (native or `docker compose -f infra/docker-compose.mysql.yml up`).
DATABASE_URL=mysql://root:YOUR_LOCAL_PASSWORD@localhost:3306/ecocharge
# Production (Node API running on the same box as the Docker MySQL container,
# bound to 127.0.0.1 only — see docs/planning/03-revamp-master.md §1.3):
# DATABASE_URL=mysql://root:PASSWORD@127.0.0.1:13306/ecocharge

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=4h
JWT_REFRESH_EXPIRES_IN=30d

# ── ESP32 device shared secret ────────────────────────────────────────────────
# Must match DEVICE_API_KEY in esp/ecocharge/include/config.h exactly.
DEVICE_API_KEY=esp32-device-secret

# ── AI Server ─────────────────────────────────────────────────────────────────
# Local:   AI_SERVER_URL=http://localhost:8001
# Tunnel:  AI_SERVER_URL=https://YOUR_TUNNEL.trycloudflare.com
AI_SERVER_URL=http://localhost:8001
AI_API_KEY=dev-ai-secret

# ── Media storage (local disk on the host running the Node API) ──────────────
# Avatars/media are written here and served back out via /media. Defaults to
# ./media next to the running process if unset.
MEDIA_STORAGE_PATH=./media

# ── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Credits config ────────────────────────────────────────────────────────────
CREDITS_PER_BOTTLE=1
MINUTES_PER_CREDIT=10

# ── Seed credentials (used by prisma/seed.ts only — never sent to clients) ────
ADMIN_NAME=EcoCharge Admin
ADMIN_EMAIL=admin@ecocharge.ph
ADMIN_PASSWORD=YourStrongPassword123!
KIOSK_NAME=Kiosk-001
KIOSK_LOCATION=Main Building Lobby
