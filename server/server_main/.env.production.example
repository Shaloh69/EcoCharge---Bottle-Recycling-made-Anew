# ── Node ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Database (self-hosted MySQL 8 in Docker, on the same box as the Node API) ─
# Bound to 127.0.0.1:13306 only — never exposed off-box. See
# docs/planning/03-revamp-master.md §1.2/§1.3.
DATABASE_URL=mysql://root:REPLACE_WITH_MYSQL_ROOT_PASSWORD@127.0.0.1:13306/ecocharge

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=4h
JWT_REFRESH_EXPIRES_IN=30d

# ── ESP32 device shared secret ────────────────────────────────────────────────
DEVICE_API_KEY=REPLACE_WITH_STRONG_DEVICE_SECRET

# ── AI Server (Cloudflare Tunnel URL) ─────────────────────────────────────────
AI_SERVER_URL=https://ai.yourdomain.com
AI_API_KEY=REPLACE_WITH_STRONG_AI_SECRET

# ── Media storage (local disk on the host running the Node API) ──────────────
MEDIA_STORAGE_PATH=D:\EcoCharge\media

# ── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://app.yourdomain.com,https://kiosk.yourdomain.com

# ── Credits config ────────────────────────────────────────────────────────────
CREDITS_PER_BOTTLE=1
MINUTES_PER_CREDIT=10

# ── Seed credentials (used by prisma/seed.ts only — never sent to clients) ────
ADMIN_NAME=EcoCharge Admin
ADMIN_EMAIL=admin@ecocharge.ph
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
KIOSK_NAME=Kiosk-001
KIOSK_LOCATION=Main Building Lobby
