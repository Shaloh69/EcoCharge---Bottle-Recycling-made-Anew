
# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── Database (Aiven MySQL) ────────────────────────────────────────────────────
# Use the MySQL tab URI from Aiven console (replace mysql:// with mysql+pymysql://)
DATABASE_URL=mysql+pymysql://avnadmin:YOUR_AIVEN_PASSWORD@ecocharge-35634afa-ecocharge123-98be.j.aivencloud.com:22294/defaultdb
DB_SSL_REQUIRED=true
# Optional: download CA cert from Aiven console → "Show CA certificate"
# Upload it to Render as a secret file, then set the path:
# DB_SSL_CA_PATH=/etc/ssl/aiven-ca.pem

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_JWT_SECRET
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ── ESP32 device shared secret ────────────────────────────────────────────────
DEVICE_API_KEY=REPLACE_WITH_STRONG_DEVICE_SECRET

# ── AI Server (Cloudflare Tunnel URL) ─────────────────────────────────────────
AI_SERVER_URL=https://ai.yourdomain.com
AI_API_KEY=REPLACE_WITH_STRONG_AI_SECRET

# ── Supabase Storage ──────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_YOUR_SECRET_KEY_HERE
SUPABASE_BUCKET=ecocharge_bucket

# ── Credits config ────────────────────────────────────────────────────────────
CREDITS_PER_BOTTLE=1
MINUTES_PER_CREDIT=10
