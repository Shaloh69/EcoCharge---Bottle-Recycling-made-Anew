# ============================================
# SCRIPTS — DATASETS & YOLO TRAINING (PYTHON)
# ============================================

# Virtual environments (keep only code)
scripts/**/venv/
scripts/**/.venv/
scripts/**/env/
scripts/**/ENV/

# Python cache
scripts/**/__pycache__/
scripts/**/*.py[cod]

# === DATASETS (ignore heavy data, keep folder structure) ===
scripts/dataset/**
!scripts/dataset/.gitkeep

# Common dataset formats
scripts/**/*.csv
scripts/**/*.jsonl
scripts/**/*.parquet
scripts/**/*.tfrecord
scripts/**/*.npy
scripts/**/*.npz
scripts/**/*.h5
scripts/**/*.pkl
scripts/**/*.pickle

# Images & videos (YOLO datasets are huge)
scripts/**/*.jpg
scripts/**/*.jpeg
scripts/**/*.png
scripts/**/*.bmp
scripts/**/*.tiff
scripts/**/*.mp4
scripts/**/*.avi
scripts/**/*.mov
scripts/**/*.mkv

# === YOLO TRAINING OUTPUTS ===
scripts/yoloTraining/**
!scripts/yoloTraining/*.py
!scripts/yoloTraining/README.md
!scripts/yoloTraining/.gitkeep

# Trained models
scripts/**/*.pt
scripts/**/*.pth
scripts/**/*.onnx
scripts/**/*.weights
scripts/**/*.engine

# Training logs
scripts/wandb/
scripts/mlruns/
scripts/runs/
scripts/tensorboard/
scripts/**/*.log

# Extracted frames / preprocessing
scripts/extract_frames/**
